<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageLens.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:StorageLens.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1040"
            Padding="{StaticResource PageContentPadding}"
            Spacing="24">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="HelpTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="HelpSubtitle" Style="{StaticResource MutedTextBlockStyle}" />
            </StackPanel>

            <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="64"
                    Height="64"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <FontIcon
                        Glyph="&#xE946;"
                        FontSize="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock x:Uid="HelpQuickStartTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="HelpQuickStartDescription" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="HelpQuickStartStepOne" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Uid="HelpQuickStartStepTwo" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Uid="HelpQuickStartStepThree" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>
            </controls:AcrylicCardGrid>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="BrowsePhotos" />
                        <TextBlock x:Uid="HelpCategoriesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Uid="HelpCategoriesDescription" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </controls:AcrylicCardGrid>
                <controls:AcrylicCardGrid Grid.Column="1" Style="{StaticResource CardGridStyle}" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock x:Uid="HelpDrillDownTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Uid="HelpDrillDownDescription" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </controls:AcrylicCardGrid>
                <controls:AcrylicCardGrid Grid.Row="1" Style="{StaticResource CardGridStyle}" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" />
                        <TextBlock x:Uid="HelpGrowthTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Uid="HelpGrowthDescription" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </controls:AcrylicCardGrid>
                <controls:AcrylicCardGrid Grid.Row="1" Grid.Column="1" Style="{StaticResource CardGridStyle}" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Delete" />
                        <TextBlock x:Uid="HelpCleanupSafetyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Uid="HelpCleanupSafetyDescription" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </controls:AcrylicCardGrid>
                <controls:AcrylicCardGrid Grid.Row="2" Style="{StaticResource CardGridStyle}" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Clock" />
                        <TextBlock x:Uid="HelpMonitoringTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Uid="HelpMonitoringDescription" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </controls:AcrylicCardGrid>
                <controls:AcrylicCardGrid Grid.Row="2" Grid.Column="1" Style="{StaticResource CardGridStyle}" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Calendar" />
                        <TextBlock x:Uid="HelpSchedulesTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Uid="HelpSchedulesDescription" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </controls:AcrylicCardGrid>
            </Grid>

            <InfoBar
                x:Uid="HelpSafetyInfoBar"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
