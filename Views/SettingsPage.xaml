<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageLens.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:StorageLens.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="36,28,36,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="SettingsTitle" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                x:Uid="ResetSettingsButton"
                Command="{x:Bind ViewModel.ResetToDefaultsCommand}" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1040"
                Padding="{StaticResource PageContentPadding}"
                Spacing="16">
                <InfoBar
                    x:Uid="SettingsPrototypeInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />

                <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="AppearanceSettingsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Uid="AppearanceSettingsDescription"
                            Style="{StaticResource MutedTextBlockStyle}" />
                    </StackPanel>
                    <RadioButtons
                        Grid.Row="1"
                        x:Uid="ThemeSelector"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                        SelectionChanged="ThemeSelector_SelectionChanged">
                        <RadioButton x:Uid="ThemeSystemOption" />
                        <RadioButton x:Uid="ThemeLightOption" />
                        <RadioButton x:Uid="ThemeDarkOption" />
                    </RadioButtons>
                </controls:AcrylicCardGrid>

                <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="ScanSettingsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch
                        Grid.Row="1"
                        x:Uid="ScanOnLaunchToggle"
                        IsOn="{x:Bind ViewModel.ScanOnLaunch, Mode=TwoWay}" />
                    <ToggleSwitch
                        Grid.Row="2"
                        x:Uid="ShowSystemItemsToggle"
                        IsOn="{x:Bind ViewModel.ShowSystemItems, Mode=TwoWay}" />
                    <ToggleSwitch
                        Grid.Row="3"
                        x:Uid="ShowHiddenItemsToggle"
                        IsOn="{x:Bind ViewModel.ShowHiddenItems, Mode=TwoWay}" />
                </controls:AcrylicCardGrid>

                <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="CleanupSettingsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch
                        Grid.Row="1"
                        x:Uid="SmartSuggestionsToggle"
                        IsOn="{x:Bind ViewModel.SmartCleanupSuggestions, Mode=TwoWay}" />
                    <ToggleSwitch
                        Grid.Row="2"
                        x:Uid="ConfirmCleanupToggle"
                        IsEnabled="False"
                        IsOn="{x:Bind ViewModel.ConfirmBeforeCleanup, Mode=OneWay}" />
                    <ToggleSwitch
                        Grid.Row="3"
                        x:Uid="ExcludeCloudOnlyToggle"
                        IsEnabled="False"
                        IsOn="{x:Bind ViewModel.ExcludeCloudOnlyFiles, Mode=OneWay}" />
                </controls:AcrylicCardGrid>

                <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" ColumnSpacing="16" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="LocalIndexTitle"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LocalIndexSizeText, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LocalIndexDetailText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <Button
                            x:Uid="CheckIndexButton"
                            Command="{x:Bind ViewModel.CheckIndexCommand}" />
                        <Button
                            x:Uid="CompactIndexButton"
                            Command="{x:Bind ViewModel.CompactIndexCommand}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Text="{x:Bind ViewModel.IndexStatus, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </controls:AcrylicCardGrid>

                <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="56"
                        Height="56"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <FontIcon
                            Glyph="&#xEDA2;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Storage Lens" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Uid="AboutDescription"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Uid="AboutVersion"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </controls:AcrylicCardGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
