<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageLens.Views.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:StorageLens.Controls"
    xmlns:local="using:StorageLens"
    xmlns:models="using:StorageLens.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ExplorerSearchFilter.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="CategorySelector.(Grid.Row)" Value="1" />
                        <Setter Target="CategorySelector.(Grid.Column)" Value="0" />
                        <Setter Target="SortSelectorControl.(Grid.Row)" Value="1" />
                        <Setter Target="SortSelectorControl.(Grid.Column)" Value="1" />
                        <Setter Target="SortSelectorControl.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ClearFilterButton.(Grid.Row)" Value="1" />
                        <Setter Target="ClearFilterButton.(Grid.Column)" Value="4" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="36,24,36,8">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="ExplorerTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <InfoBar
                    x:Uid="ExplorerNoScanInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind local:Converters.Not(ViewModel.HasScanData), Mode=OneWay}"
                    Severity="Informational" />
                <InfoBar
                    x:Uid="ExplorerErrorInfoBar"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="ExplorerFilterGrid"
            Grid.Row="1"
            Padding="36,8,36,16"
            ColumnSpacing="12"
            RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ComboBox
                x:Name="DriveSelectorControl"
                x:Uid="ExplorerDriveSelector"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                ItemsSource="{x:Bind ViewModel.Drives}"
                SelectedIndex="{x:Bind ViewModel.SelectedDriveIndex, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.HasAvailableDrive}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DriveSummary">
                        <TextBlock Text="{x:Bind DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <AutoSuggestBox
                x:Name="ExplorerSearchFilter"
                Grid.Column="1"
                x:Uid="ExplorerSearchBox"
                MinWidth="180"
                VerticalAlignment="Bottom"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                x:Name="CategorySelector"
                Grid.Column="2"
                x:Uid="CategoryFilter"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                ItemsSource="{x:Bind ViewModel.Categories}"
                SelectedIndex="{x:Bind ViewModel.SelectedCategoryIndex, Mode=TwoWay}" />
            <ComboBox
                x:Name="SortSelectorControl"
                Grid.Column="3"
                x:Uid="SortSelector"
                MinWidth="180"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}" />
            <Button
                x:Name="ClearFilterButton"
                Grid.Column="4"
                x:Uid="ClearFiltersButton"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ClearFiltersCommand}" />
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="36,0,36,36"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="256" MaxWidth="512" />
                <ColumnDefinition Width="3*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <controls:AcrylicCardGrid
                Style="{StaticResource CardGridStyle}"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Symbol="Folder" />
                    <TextBlock
                        Grid.Column="1"
                        x:Uid="FolderTreeTitle"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                </Grid>

                <TreeView
                    x:Name="FolderTreeView"
                    Grid.Row="1"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ItemsSource="{x:Bind ViewModel.FolderTree}"
                    SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=OneWay}"
                    SelectionMode="Single"
                    Expanding="FolderTreeView_Expanding"
                    SelectionChanged="FolderTreeView_SelectionChanged">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="models:StorageFolderNode">
                            <TreeViewItem
                                AutomationProperties.Name="{x:Bind AccessibleSummary}"
                                HorizontalContentAlignment="Stretch"
                                HasUnrealizedChildren="{x:Bind HasChildren}"
                                IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                ItemsSource="{x:Bind Children}">
                                <TreeViewItem.Content>
                                    <Grid RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            MaxLines="2" />
                                        <Grid Grid.Row="1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{x:Bind local:StorageFormatter.FormatBytes(DisplaySizeBytes)}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind GrowthText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                                Visibility="{x:Bind HasGrowth}" />
                                        </Grid>
                                    </Grid>
                                </TreeViewItem.Content>
                                <ToolTipService.ToolTip>
                                    <TextBlock
                                        Text="{x:Bind DisplayPath}"
                                        FlowDirection="LeftToRight"
                                        TextWrapping="Wrap"
                                        MaxWidth="560" />
                                </ToolTipService.ToolTip>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </controls:AcrylicCardGrid>

            <Grid
                Grid.Column="1"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="StorageItemsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Button
                                    x:Uid="NavigateUpButton"
                                    MinWidth="0"
                                    Padding="8,4"
                                    Command="{x:Bind ViewModel.NavigateUpCommand}">
                                    <FontIcon Glyph="&#xE74A;" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.LocationText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ListView
                        x:Name="StorageItemsListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.FilteredItems}"
                        ItemContainerStyle="{StaticResource SelectableListViewItemStyle}"
                        SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                        IsItemClickEnabled="True"
                        ItemClick="StorageItemsListView_ItemClick"
                        ContainerContentChanging="StorageItemsListView_ContainerContentChanging">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:StorageItem">
                                <Grid
                                    Padding="14"
                                    Background="{ThemeResource ControlFillColorTransparentBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Width="40"
                                        Height="40"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Glyph="{x:Bind Glyph}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind DisplayPath}"
                                            FlowDirection="LeftToRight"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayCategory}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind DisplayKind}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind local:StorageFormatter.FormatBytes(DisplaySizeBytes)}"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind Modified}"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind GrowthText}"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                            Visibility="{x:Bind HasGrowth}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ProgressRing
                        Grid.Row="1"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </controls:AcrylicCardGrid>

                <controls:AcrylicCardGrid
                    Grid.Row="1"
                    Padding="12"
                    Style="{StaticResource CardGridStyle}"
                    ColumnSpacing="12"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Width="40"
                        Height="40"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Symbol="OpenFile"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedItemNameText, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedItemPathText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FlowDirection="LeftToRight"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedItem.DisplayCategory, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                Visibility="{x:Bind ViewModel.SelectedItem.IsReclaimable, Mode=OneWay}"
                                x:Uid="ReclaimableCandidateLabel"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock
                                Visibility="{x:Bind ViewModel.SelectedItem.IsSystem, Mode=OneWay}"
                                x:Uid="SystemItemLabel"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            Text="{x:Bind local:StorageFormatter.FormatBytes(ViewModel.SelectedItem.DisplaySizeBytes), Mode=OneWay}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedItem.GrowthText, Mode=OneWay}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                            Visibility="{x:Bind ViewModel.SelectedItem.HasGrowth, Mode=OneWay}" />
                    </StackPanel>
                    <Grid
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Right"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Uid="OpenChildrenButton"
                            Visibility="{x:Bind ViewModel.CanOpenSelectedItem, Mode=OneWay}"
                            Click="OpenSelectedItemButton_Click" />
                        <Button
                            Grid.Column="1"
                            x:Uid="OpenLocationButton"
                            Command="{x:Bind ViewModel.RevealSelectedCommand}" />
                    </Grid>
                </controls:AcrylicCardGrid>
            </Grid>
        </Grid>
    </Grid>
</Page>
