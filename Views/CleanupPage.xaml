<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageLens.Views.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:StorageLens.Controls"
    xmlns:local="using:StorageLens"
    xmlns:models="using:StorageLens.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Padding="36,28,36,20"
            ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="CleanupTitle"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="{x:Bind ViewModel.ScopeText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid
                Grid.Column="1"
                VerticalAlignment="Bottom"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Uid="SelectSafeButton"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.SelectSafeItemsCommand}" />
                <Button
                    Grid.Column="1"
                    x:Uid="ClearSelectionButton"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ClearSelectionCommand}" />
            </Grid>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="36,0,36,20"
            Spacing="8">
            <InfoBar
                x:Uid="CleanupSafetyInfoBar"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                x:Name="CleanupResultInfoBar"
                IsClosable="True"
                IsOpen="False" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="2"
            Padding="{StaticResource PageContentPadding}"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recommendations}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsJustification="Start"
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="3"
                        MinColumnSpacing="12"
                        MinItemWidth="320"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:CleanupRecommendation">
                        <Grid MinHeight="264">
                            <Button
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Padding="0"
                                Tag="{x:Bind PolicyId, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind AccessibleSummary, Mode=OneWay}"
                                Click="RecommendationDetailsButton_Click"
                                Style="{StaticResource CardButtonStyle}">
                                <controls:AcrylicCardGrid
                                    Style="{StaticResource CardGridStyle}"
                                    RowSpacing="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Width="44"
                                            Height="44"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                            <FontIcon
                                                Glyph="{x:Bind Glyph}"
                                                FontSize="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Grid>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="0,0,40,0"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind DisplayName}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{x:Bind SafetyLabel}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind DisplayDescription}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <Grid
                                        Grid.Row="2"
                                        ColumnSpacing="16"
                                        VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind ItemCountText, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ActionLabel}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind local:StorageFormatter.FormatBytes(SelectedReclaimableBytes), Mode=OneWay}"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind SpaceLabel}"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid
                                        Grid.Row="3"
                                        Padding="8,4"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <Grid
                                            Visibility="{x:Bind IsSafe}">
                                            <TextBlock
                                                Text="{x:Bind SafetyLabel}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                        <Grid
                                            Visibility="{x:Bind IsReview}">
                                            <TextBlock
                                                Text="{x:Bind SafetyLabel}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                        <Grid
                                            Visibility="{x:Bind IsCaution}">
                                            <TextBlock
                                                Text="{x:Bind SafetyLabel}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </Grid>
                                </controls:AcrylicCardGrid>
                            </Button>

                            <CheckBox
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,12,12,0"
                                MinWidth="0"
                                AutomationProperties.Name="{x:Bind AccessibleSummary, Mode=OneWay}"
                                AutomationProperties.AutomationId="{x:Bind SelectionAutomationId}"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                Visibility="{x:Bind IsActionable}" />
                            <FontIcon
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,20,20,0"
                                Glyph="&#xE7BA;"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Visibility="{x:Bind IsCaution}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <Grid
            Grid.Row="3"
            Padding="36,16"
            Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SelectedForReviewLabel"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"
                        Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SelectedGroupLabel, Mode=OneWay}"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Text="{x:Bind ViewModel.SelectedSizeText, Mode=OneWay}"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}" />
            <Button
                Grid.Column="2"
                x:Uid="ReviewSelectedButton"
                MinWidth="164"
                Style="{StaticResource AccentButtonStyle}"
                IsEnabled="{x:Bind ViewModel.CanReview, Mode=OneWay}"
                Click="ReviewSelectedButton_Click" />
        </Grid>

        <ContentDialog
            x:Name="CleanupReviewDialog"
            x:Uid="CleanupReviewDialog"
            Grid.RowSpan="4"
            IsPrimaryButtonEnabled="{x:Bind ViewModel.CanReview, Mode=OneWay}"
            PrimaryButtonClick="CleanupReviewDialog_PrimaryButtonClick"
            Closing="CleanupReviewDialog_Closing"
            DefaultButton="Close">
            <StackPanel Spacing="12">
                <TextBlock
                    x:Uid="CleanupReviewDialogMessage"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
                <Grid
                    Padding="16"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="CleanupReviewSelectionLabel"
                            Style="{StaticResource MetadataTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.SelectedSizeText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedRecommendations, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:CleanupRecommendation">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind DisplayName}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind SafetyLabel}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind local:StorageFormatter.FormatBytes(SelectedReclaimableBytes), Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock
                    x:Uid="CleanupReviewSafetyNote"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>

    </Grid>
</Page>
