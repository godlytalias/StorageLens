<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageLens.Views.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:StorageLens.Controls"
    xmlns:models="using:StorageLens.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowAutomation">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MonitorSettingsCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="BackgroundIndexCard.(Grid.Row)" Value="1" />
                        <Setter Target="BackgroundIndexCard.(Grid.Column)" Value="0" />
                        <Setter Target="BackgroundIndexCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="AutomationStatusCard.(Grid.Row)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideAutomation">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="36,28,36,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="AutomationTitle" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                x:Uid="AutomationPreviewAlertButton"
                Command="{x:Bind ViewModel.PreviewAlertCommand}" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1100"
                Padding="{StaticResource PageContentPadding}"
                Spacing="16">
                <InfoBar
                    x:Uid="AutomationSafetyInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational" />

                <Grid
                    x:Name="AutomationSettingsGrid"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:AcrylicCardGrid
                        x:Name="MonitorSettingsCard"
                        Style="{StaticResource CardGridStyle}"
                        RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="48"
                                Height="48"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <FontIcon
                                    Glyph="&#xE9D9;"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="StorageMonitorCardTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="StorageMonitorCardDescription"
                                    Style="{StaticResource MutedTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                x:Uid="StorageMonitorToggle"
                                IsOn="{x:Bind ViewModel.MonitorEnabled, Mode=TwoWay}" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="12"
                            RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox
                                x:Uid="MonitorFrequencyComboBox"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.MonitorIntervalLabels}"
                                SelectedIndex="{x:Bind ViewModel.MonitorIntervalIndex, Mode=TwoWay}" />
                            <NumberBox
                                Grid.Column="1"
                                x:Uid="LowSpaceThresholdNumberBox"
                                Minimum="1"
                                Maximum="500"
                                SmallChange="5"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.LowSpaceThresholdGb, Mode=TwoWay}" />
                            <NumberBox
                                Grid.Row="1"
                                x:Uid="GrowthThresholdNumberBox"
                                Minimum="5"
                                Maximum="500"
                                SmallChange="5"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.GrowthThresholdGb, Mode=TwoWay}" />
                            <NumberBox
                                Grid.Row="1"
                                Grid.Column="1"
                                x:Uid="TrackedFolderSizeNumberBox"
                                Minimum="1"
                                Maximum="500"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.MinimumTrackedFolderSizeGb, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Grid.Row="2" Spacing="8">
                            <TextBlock
                                x:Uid="NotificationPreferencesTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ToggleSwitch
                                x:Uid="LowSpaceNotificationsToggle"
                                IsOn="{x:Bind ViewModel.NotifyOnLowSpace, Mode=TwoWay}" />
                            <ToggleSwitch
                                x:Uid="FolderGrowthNotificationsToggle"
                                IsOn="{x:Bind ViewModel.NotifyOnFolderGrowth, Mode=TwoWay}" />
                        </StackPanel>
                    </controls:AcrylicCardGrid>

                    <controls:AcrylicCardGrid
                        x:Name="BackgroundIndexCard"
                        Grid.Column="1"
                        Style="{StaticResource CardGridStyle}"
                        RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="48"
                                Height="48"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <SymbolIcon
                                    Symbol="Sync"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    x:Uid="BackgroundIndexCardTitle"
                                    Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="BackgroundIndexCardDescription"
                                    Style="{StaticResource MutedTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                x:Uid="BackgroundIndexToggle"
                                IsOn="{x:Bind ViewModel.BackgroundIndexEnabled, Mode=TwoWay}" />
                        </Grid>
                        <NumberBox
                            Grid.Row="1"
                            x:Uid="BackgroundIndexIntervalNumberBox"
                            Minimum="1"
                            Maximum="7"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.BackgroundIndexIntervalDays, Mode=TwoWay}" />
                        <StackPanel Grid.Row="2" Spacing="4">
                            <TextBlock
                                Text="{x:Bind ViewModel.NextScanText, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.BackgroundIndexStatusText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <InfoBar
                            Grid.Row="3"
                            x:Uid="BackgroundIndexSafetyInfoBar"
                            IsClosable="False"
                            IsOpen="True"
                            Severity="Informational" />
                    </controls:AcrylicCardGrid>

                    <controls:AcrylicCardGrid
                        x:Name="AutomationStatusCard"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource CardGridStyle}"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE946;"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="2"
                            x:Uid="SaveAutomationButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveMonitoringSettingsCommand}" />
                    </controls:AcrylicCardGrid>
                </Grid>

                <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Symbol="Clock" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="CleanupSchedulesTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Uid="CleanupSchedulesDescription" Style="{StaticResource MutedTextBlockStyle}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            x:Uid="AddCleanupScheduleButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddScheduleButton_Click" />
                    </Grid>

                    <ItemsRepeater
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.CleanupSchedules}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:ScheduledCleanupTask">
                                <controls:AcrylicCardGrid
                                    Padding="16"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind Name}"
                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind CategorySummary}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{x:Bind ModeText}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="{x:Bind IntervalText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="{x:Bind NextRunText}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="3"
                                        Tag="{x:Bind Id, Mode=OneWay}"
                                        x:Uid="EditScheduleButton"
                                        Click="EditScheduleButton_Click" />
                                    <Button
                                        Grid.Column="4"
                                        Tag="{x:Bind Id, Mode=OneWay}"
                                        x:Uid="DeleteScheduleButton"
                                        Click="DeleteScheduleButton_Click" />
                                </controls:AcrylicCardGrid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </controls:AcrylicCardGrid>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog
            x:Name="ScheduleDialog"
            x:Uid="ScheduleDialog"
            Grid.RowSpan="2"
            PrimaryButtonClick="ScheduleDialog_PrimaryButtonClick"
            DefaultButton="Primary">
            <StackPanel Spacing="16">
                <TextBox
                    x:Uid="ScheduleNameTextBox"
                    Text="{x:Bind ViewModel.DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    x:Uid="ScheduleFrequencyComboBox"
                    ItemsSource="{x:Bind ViewModel.ScheduleIntervalLabels}"
                    SelectedIndex="{x:Bind ViewModel.DraftIntervalIndex, Mode=TwoWay}" />
                <ToggleSwitch
                    x:Uid="ScheduleEnabledToggle"
                    IsOn="{x:Bind ViewModel.DraftEnabled, Mode=TwoWay}" />
                <ToggleSwitch
                    x:Uid="ScheduleAutomaticCleanupToggle"
                    IsOn="{x:Bind ViewModel.DraftAutomaticCleanup, Mode=TwoWay}" />
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="ScheduleCategoriesLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.DraftCategories}">
                        <ItemsRepeater.Layout>
                            <StackLayout
                                Orientation="Vertical"
                                Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:CleanupCategorySelection">
                                <CheckBox
                                    MinWidth="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                    <TextBlock
                                        Text="{x:Bind DisplayName}"
                                        TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                <InfoBar
                    x:Uid="ScheduleSafetyInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Warning" />
                <InfoBar
                    x:Name="ScheduleValidationInfoBar"
                    x:Uid="ScheduleValidationInfoBar"
                    IsOpen="False"
                    Severity="Error" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
