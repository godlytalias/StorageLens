<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StorageLens.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:StorageLens.Controls"
    xmlns:local="using:StorageLens"
    xmlns:models="using:StorageLens.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">
    <Grid RowSpacing="0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowOverview">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OverviewHeroActionColumn.Width" Value="0" />
                        <Setter Target="CleanupOpportunityCard.(Grid.Row)" Value="1" />
                        <Setter Target="CleanupOpportunityCard.(Grid.Column)" Value="0" />
                        <Setter Target="CleanupOpportunityCard.(Grid.ColumnSpan)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideOverview">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1080" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="36,28,36,20"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Uid="OverviewTitle"
                    Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>

            <ComboBox
                Grid.Column="1"
                x:Uid="DriveSelector"
                MinWidth="224"
                VerticalAlignment="Bottom"
                ItemsSource="{x:Bind ViewModel.Drives}"
                SelectedIndex="{x:Bind ViewModel.SelectedDriveIndex, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.HasAvailableDrive}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DriveSummary">
                        <TextBlock Text="{x:Bind DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button
                Grid.Column="2"
                x:Uid="ScanStorageButton"
                MinWidth="136"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ScanCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                        IsIndeterminate="True"
                        Width="16"
                        Height="16" />
                    <TextBlock x:Uid="ScanStorageButtonLabel" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="3"
                x:Uid="CancelScanButton"
                VerticalAlignment="Bottom"
                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                Command="{x:Bind ViewModel.CancelScanCommand}" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Padding="{StaticResource PageContentPadding}"
                Spacing="28">
                <InfoBar
                    x:Uid="NoScanDataInfoBar"
                    Visibility="{x:Bind ViewModel.NeedsFirstScan, Mode=OneWay}"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.NeedsFirstScan, Mode=OneWay}"
                    Severity="Informational" />
                <InfoBar
                    x:Uid="OverviewErrorInfoBar"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />
                <Expander
                    x:Uid="IndexDetailsExpander"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.HasCoverageStatus, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind ViewModel.CoverageStatus, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </Expander>
                <controls:AcrylicCardGrid
                    x:Name="OverviewHeroCard"
                    Style="{StaticResource HeroCardGridStyle}"
                    ColumnSpacing="28"
                    RowSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition
                            x:Name="OverviewHeroActionColumn"
                            Width="288" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Width="168"
                        Height="168"
                        VerticalAlignment="Center">
                        <ProgressRing
                            x:Uid="StorageUsageRing"
                            Width="160"
                            Height="160"
                            IsIndeterminate="False"
                            Maximum="100"
                            Value="{x:Bind ViewModel.SelectedDrive.UsedPercentage, Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="0">
                            <TextBlock
                                Text="{x:Bind local:StorageFormatter.FormatPercentage(ViewModel.SelectedDrive.UsedPercentage), Mode=OneWay}"
                                HorizontalAlignment="Center"
                                Style="{StaticResource TitleLargeTextBlockStyle}" />
                            <TextBlock
                                x:Uid="StorageUsedLabel"
                                HorizontalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedDrive.DisplayName, Mode=OneWay}"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.SelectedDrive.FileSystem, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ProgressBar
                            x:Uid="OverviewStorageProgressBar"
                            Value="{x:Bind ViewModel.SelectedDrive.UsedPercentage, Mode=OneWay}"
                            Maximum="100"
                            Style="{StaticResource StorageProgressBarStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="UsedSpaceLabel" Style="{StaticResource MetadataTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.UsedStorageText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="FreeSpaceLabel" Style="{StaticResource MetadataTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.FreeStorageText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock x:Uid="CapacityLabel" Style="{StaticResource MetadataTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.TotalStorageText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE823;"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ProgressBar
                            x:Uid="ScanProgressBar"
                            Maximum="1"
                            Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                    </StackPanel>

                    <controls:AcrylicCardGrid
                        x:Name="CleanupOpportunityCard"
                        Grid.Column="2"
                        Style="{StaticResource CardGridStyle}"
                        Padding="20"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <FontIcon
                            Glyph="&#xE74D;"
                            FontSize="24"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock x:Uid="CleanupOpportunityLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.CleanupPotentialText, Mode=OneWay}"
                                Style="{StaticResource TitleTextBlockStyle}" />
                        </StackPanel>
                        <Button
                            Grid.Row="3"
                            x:Uid="ReviewCleanupButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="ReviewCleanupButton_Click" />
                    </controls:AcrylicCardGrid>
                </controls:AcrylicCardGrid>

                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9F9;" />
                        <TextBlock x:Uid="CategoryBreakdownTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Categories}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="16"
                                MinItemWidth="220"
                                MinRowSpacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:StorageCategory">
                                <Button
                                    Tag="{x:Bind Name, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind DisplayName}"
                                    Style="{StaticResource CardButtonStyle}"
                                    Click="CategoryTile_Click">
                                    <controls:AcrylicCardGrid
                                        MinHeight="168"
                                        Style="{StaticResource CardGridStyle}"
                                        RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="44"
                                                Height="44"
                                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                CornerRadius="{StaticResource ControlCornerRadius}">
                                                <FontIcon
                                                    Glyph="{x:Bind Glyph}"
                                                    FontSize="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind local:StorageFormatter.FormatBytes(SizeBytes)}"
                                                    Style="{StaticResource SubtitleTextBlockStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <ProgressBar
                                            x:Uid="CategoryStorageProgressBar"
                                            Grid.Row="2"
                                            Maximum="100"
                                            Value="{x:Bind Percentage}"
                                            Style="{StaticResource StorageProgressBarStyle}" />
                                        <TextBlock
                                            Grid.Row="3"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind local:StorageFormatter.FormatPercentage(Percentage)}" />
                                    </controls:AcrylicCardGrid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock
                        x:Uid="CategoryBreakdownEmpty"
                        Margin="0,8,0,0"
                        Style="{StaticResource MutedTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasNoCategories, Mode=OneWay}" />
                </StackPanel>

                <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE9D9;"
                            FontSize="20"
                            Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="GrowingFoldersTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="GrowingFoldersDescription"
                                Style="{StaticResource MutedTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid
                            Grid.Column="2"
                            Padding="8,4"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <TextBlock
                                Text="{x:Bind ViewModel.GrowthTrackingThresholdText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Padding="16"
                        Spacing="4"
                        Visibility="{x:Bind ViewModel.HasNoGrowingFolders, Mode=OneWay}">
                        <TextBlock
                            x:Uid="GrowingFoldersEmptyTitle"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Uid="GrowingFoldersEmptyHint"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsRepeater
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.GrowingFolders}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="16"
                                MinItemWidth="240"
                                MinRowSpacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:FolderGrowthInsight">
                                <Button
                                    Tag="{x:Bind Path, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    Style="{StaticResource ListRowButtonStyle}"
                                    Click="GrowingFolder_Click">
                                    <controls:AcrylicCardGrid
                                        Style="{StaticResource TileGridStyle}"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <SymbolIcon Symbol="Folder" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                Text="{x:Bind DisplayPath}"
                                                FlowDirection="LeftToRight"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind GrowthText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind AddedText}"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                            <TextBlock
                                                Text="{x:Bind local:StorageFormatter.FormatBytes(SizeBytes)}"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </controls:AcrylicCardGrid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </controls:AcrylicCardGrid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Uid="TopFoldersTitle" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <ItemsRepeater
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.TopFolders}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="16"
                                    MinItemWidth="220"
                                    MinRowSpacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:StorageFolderNode">
                                    <Button
                                        Tag="{x:Bind Path, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind AccessibleSummary}"
                                        Style="{StaticResource CardButtonStyle}"
                                        Click="TopFolder_Click">
                                        <ToolTipService.ToolTip>
                                            <TextBlock
                                                MaxWidth="560"
                                                Text="{x:Bind DisplayPath}"
                                                FlowDirection="LeftToRight"
                                                TextWrapping="Wrap" />
                                        </ToolTipService.ToolTip>
                                        <controls:AcrylicCardGrid
                                            MinHeight="148"
                                            Style="{StaticResource TileGridStyle}"
                                            RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    Width="36"
                                                    Height="36"
                                                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <SymbolIcon
                                                        Symbol="Folder"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Grid>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{x:Bind DisplayTag}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock
                                                Grid.Row="1"
                                                Text="{x:Bind DisplayPath}"
                                                FlowDirection="LeftToRight"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="2"
                                                TextWrapping="Wrap" />
                                            <StackPanel
                                                Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="6">
                                                <TextBlock
                                                    Text="{x:Bind local:StorageFormatter.FormatBytes(DisplaySizeBytes)}"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <FontIcon
                                                    Glyph="&#xE76C;"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </controls:AcrylicCardGrid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            Grid.Row="1"
                            x:Uid="TopFoldersEmpty"
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNoTopFolders, Mode=OneWay}" />
                        <HyperlinkButton
                            Grid.Row="2"
                            x:Uid="ExploreStorageButton"
                            HorizontalAlignment="Left"
                            Click="ExploreStorageButton_Click" />
                    </controls:AcrylicCardGrid>

                    <controls:AcrylicCardGrid
                        Grid.Column="1"
                        Style="{StaticResource CardGridStyle}"
                        RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Uid="CleanupSuggestionsTitle" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <ItemsRepeater
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.CleanupSuggestions}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="16"
                                    MinItemWidth="220"
                                    MinRowSpacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:CleanupRecommendation">
                                    <Button
                                        Tag="{x:Bind PolicyId, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind AccessibleSummary, Mode=OneWay}"
                                        Style="{StaticResource CardButtonStyle}"
                                        Click="CleanupRecommendation_Click">
                                        <controls:AcrylicCardGrid
                                            MinHeight="148"
                                            Style="{StaticResource TileGridStyle}"
                                            RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    Width="36"
                                                    Height="36"
                                                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <FontIcon
                                                        Glyph="{x:Bind Glyph}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Grid>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                                    <TextBlock
                                                        Text="{x:Bind DisplayName}"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Text="{x:Bind SafetyLabel}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock
                                                Grid.Row="1"
                                                Text="{x:Bind DisplayDescription}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="2"
                                                TextWrapping="Wrap" />
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind ItemCountText, Mode=OneWay}"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind local:StorageFormatter.FormatBytes(ReclaimableBytes)}"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            </Grid>
                                        </controls:AcrylicCardGrid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            Grid.Row="1"
                            x:Uid="CleanupSuggestionsEmpty"
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNoCleanupSuggestions, Mode=OneWay}" />
                        <Button
                            Grid.Row="2"
                            x:Uid="OpenCleanupReviewButton"
                            Click="ReviewCleanupButton_Click" />
                    </controls:AcrylicCardGrid>
                </Grid>

                <controls:AcrylicCardGrid Style="{StaticResource CardGridStyle}" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="LargestFilesTitle" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <ItemsRepeater
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.LargestFiles}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="16"
                                MinItemWidth="248"
                                MinRowSpacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:StorageItem">
                                <Button
                                    Tag="{x:Bind Path, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind AccessibleSummary}"
                                    Style="{StaticResource CardButtonStyle}"
                                    Click="LargestFile_Click">
                                    <ToolTipService.ToolTip>
                                        <TextBlock
                                            MaxWidth="560"
                                            Text="{x:Bind DisplayPath}"
                                            FlowDirection="LeftToRight"
                                            TextWrapping="Wrap" />
                                    </ToolTipService.ToolTip>
                                    <controls:AcrylicCardGrid
                                    MinHeight="164"
                                    Style="{StaticResource TileGridStyle}"
                                    RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid
                                            Width="36"
                                            Height="36"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                            <FontIcon
                                                Glyph="{x:Bind Glyph}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Grid>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                            <TextBlock
                                                Text="{x:Bind DisplayCategory}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind DisplayPath}"
                                        FlowDirection="LeftToRight"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="2"
                                        TextWrapping="Wrap" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{x:Bind Modified}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind local:StorageFormatter.FormatBytes(DisplaySizeBytes)}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                </controls:AcrylicCardGrid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock
                        Grid.Row="1"
                        x:Uid="LargestFilesEmpty"
                        VerticalAlignment="Center"
                        Style="{StaticResource MutedTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasNoLargestFiles, Mode=OneWay}" />
                </controls:AcrylicCardGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
