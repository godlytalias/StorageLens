  <data name="HelpTitle.Text" xml:space="preserve">
    <value>सहायता</value>
  </data>
  <data name="HelpSubtitle.Text" xml:space="preserve">
    <value>स्टोरेज उपयोग पढ़ना, बड़े फ़ोल्डरों की जाँच करना, साफ़-सफ़ाई सुरक्षा समझना और स्वचालन कॉन्फ़िगर करना सीखें।</value>
  </data>
  <data name="HelpQuickStartTitle.Text" xml:space="preserve">
    <value>त्वरित शुरुआत</value>
  </data>
  <data name="HelpQuickStartDescription.Text" xml:space="preserve">
    <value>Storage Lens को पढ़ें → जाँचें → समीक्षा करें वर्कफ़्लो के रूप में डिज़ाइन किया गया है।</value>
  </data>
  <data name="HelpQuickStartStepOne.Text" xml:space="preserve">
    <value>1. अवलोकन से शुरू करें और उपयोग की गई, खाली तथा समीक्षा योग्य जगह की तुलना करें।</value>
  </data>
  <data name="HelpQuickStartStepTwo.Text" xml:space="preserve">
    <value>2. किसी भी श्रेणी, सबसे बड़े आइटम या बढ़ते फ़ोल्डर पर क्लिक करके उसे स्टोरेज ब्राउज़र में खोलें।</value>
  </data>
  <data name="HelpQuickStartStepThree.Text" xml:space="preserve">
    <value>3. साफ़-सफ़ाई समीक्षा खोलें, हर फ़ोल्डर ट्री की मिलती फ़ाइलें जाँचें, जो रखना है उसका चेक हटाएँ और साफ़-सफ़ाई की पुष्टि करें।</value>
  </data>
  <data name="HelpCategoriesTitle.Text" xml:space="preserve">
    <value>श्रेणियाँ पढ़ना</value>
  </data>
  <data name="HelpCategoriesDescription.Text" xml:space="preserve">
    <value>श्रेणियाँ स्टोरेज को उद्देश्य के अनुसार समूहित करती हैं: ऐप, वीडियो, फ़ोटो, सिस्टम, दस्तावेज़, अस्थायी डेटा या अन्य। चुनी गई ड्राइव के सभी मिलते-जुलते आइटम फ़िल्टर करने के लिए श्रेणी टाइल पर क्लिक करें।</value>
  </data>
  <data name="HelpDrillDownTitle.Text" xml:space="preserve">
    <value>फ़ोल्डरों में गहराई से जाना</value>
  </data>
  <data name="HelpDrillDownDescription.Text" xml:space="preserve">
    <value>ट्री से फ़ोल्डर चुनें या आइटम सूची में उसकी पंक्ति पर क्लिक करके उसके सीधे चाइल्ड आइटम दिखाएँ। मूल फ़ोल्डर पर लौटने के लिए ऊपर जाने वाला बटन उपयोग करें।</value>
  </data>
  <data name="HelpGrowthTitle.Text" xml:space="preserve">
    <value>बढ़ते फ़ोल्डरों को ढूँढ़ना</value>
  </data>
  <data name="HelpGrowthDescription.Text" xml:space="preserve">
    <value>वृद्धि अनुभाग हाल के स्कैन स्नैपशॉट की तुलना करता है और बताता है कि खाली जगह कहाँ सबसे तेज़ी से घट रही है। स्वचालन में ट्रैक किए जाने वाले फ़ोल्डर का न्यूनतम आकार बदलें; शुरुआत 1 GB से होती है।</value>
  </data>
  <data name="HelpCleanupSafetyTitle.Text" xml:space="preserve">
    <value>साफ़-सफ़ाई सुरक्षा</value>
  </data>
  <data name="HelpCleanupSafetyDescription.Text" xml:space="preserve">
    <value>सुरक्षित, समीक्षा और सावधानी अलग-अलग भरोसे के स्तर हैं। हर उम्मीदवार पेज देखने के लिए किसी अनुशंसा पर क्लिक करें। पुष्टि की गई साफ़-सफ़ाई पात्र आइटमों को रीसायकल बिन में ले जाती है; सुरक्षित और बदली गई फ़ाइलें छोड़ दी जाती हैं।</value>
  </data>
  <data name="HelpMonitoringTitle.Text" xml:space="preserve">
    <value>पृष्ठभूमि निगरानी</value>
  </data>
  <data name="HelpMonitoringDescription.Text" xml:space="preserve">
    <value>कम जगह और फ़ोल्डर की वृद्धि के अलर्ट पाने के लिए स्वचालन में निगरानी चालू करें।</value>
  </data>
  <data name="HelpSchedulesTitle.Text" xml:space="preserve">
    <value>शेड्यूल की गई साफ़-सफ़ाई समीक्षाएँ</value>
  </data>
  <data name="HelpSchedulesDescription.Text" xml:space="preserve">
    <value>दैनिक, साप्ताहिक, द्विसाप्ताहिक या मासिक श्रेणी समीक्षा बनाएं। समीक्षा शेड्यूल सूचना भेजते हैं; स्वचालित सफ़ाई केवल अभी भी पात्र फ़ाइलों को रीसायकल बिन में ले जाती है।</value>
  </data>
  <data name="HelpSafetyInfoBar.Title" xml:space="preserve">
    <value>आपकी फ़ाइलें आपकी ही रहती हैं</value>
  </data>
