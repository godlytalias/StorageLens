<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StorageLens.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="ShellCanvasBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F3F6FC" Offset="0" />
                <GradientStop Color="#E6EDF8" Offset="1" />
            </LinearGradientBrush>
            <StaticResource x:Key="CardSurfaceBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="CardSurfaceStrokeBrush" ResourceKey="SurfaceStrokeColorDefaultBrush" />
            <SolidColorBrush x:Key="CardShadowBrush" Color="Black" />
            <Thickness x:Key="CardSurfaceBorderThickness">1</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="ShellCanvasBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#222A38" Offset="0" />
                <GradientStop Color="#141B28" Offset="1" />
            </LinearGradientBrush>
            <StaticResource x:Key="CardSurfaceBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="CardSurfaceStrokeBrush" ResourceKey="SurfaceStrokeColorDefaultBrush" />
            <SolidColorBrush x:Key="CardShadowBrush" Color="Black" />
            <Thickness x:Key="CardSurfaceBorderThickness">1</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="ShellCanvasBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="CardSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="CardSurfaceStrokeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="CardShadowBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <Thickness x:Key="CardSurfaceBorderThickness">2</Thickness>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="PageContentPadding">36,28,36,40</Thickness>

    <Style x:Key="CardGridStyle" TargetType="controls:AcrylicCardGrid">
        <Setter Property="Background" Value="{ThemeResource CardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardSurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource CardSurfaceBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="TileGridStyle" TargetType="controls:AcrylicCardGrid" BasedOn="{StaticResource CardGridStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="HeroCardGridStyle" TargetType="controls:AcrylicCardGrid" BasedOn="{StaticResource CardGridStyle}">
        <Setter Property="Padding" Value="28" />
    </Style>

    <Style x:Key="SectionHeaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="MutedTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="MetadataTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="StorageProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
        <Setter Property="Height" Value="8" />
    </Style>

    <Style x:Key="SelectableListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListRowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</ResourceDictionary>
